{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Novi",
  "version": "0.3.0-beta.1",
  "identifier": "com.novi.desktop",

  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:8765 http://localhost:5173; connect-src 'self' http://127.0.0.1:8765 ws://127.0.0.1:8765 http://localhost:5173 ws://localhost:5173; img-src 'self' data: blob: http://127.0.0.1:8765 http://localhost:5173; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self';"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": ["resources"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZCOTI4RTgwNjY3NDE4OUYKUldTZkdIUm1nSTZTK3dSWWcrWFhIV1pWQ2RHRjc0WXFJR1lHZ2Ixc2RjVzdPMUFLc3ljL2JQSWwK",
      "endpoints": [
        "https://github.com/rasumeng/Novi/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
